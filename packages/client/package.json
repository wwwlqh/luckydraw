{
  "name": "@luckydraw/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared LuckyDraw client library: generated ABIs and bigint types, spec math mirrored from the reference vectors, manifest loading and verification, error decoding and the string catalog (SPEC sections 8, 9.6, 9.7, 10.1, 11.2, 12).",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "abi:generate": "node scripts/generate.ts",
    "abi:check": "node scripts/generate.ts --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "5.9.3"
  }
}
