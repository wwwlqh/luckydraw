# LuckyDraw keeper EnvironmentFile template.
#
# Copy to /etc/luckydraw/keeper.env, replace every <...> placeholder, then:
#   chown root:root /etc/luckydraw/keeper.env && chmod 600 /etc/luckydraw/keeper.env
#
# Every value here is committed to nothing: this file is a template and holds placeholders only.
#
# THE SIGNING KEY IS NOT IN THIS FILE. It is delivered by systemd LoadCredential= from
# /etc/luckydraw/keeper-private-key (root:root, 0600). Adding KEEPER_PRIVATE_KEY here would put it into the
# unit's environment, where `systemctl show -p Environment` and /proc/<pid>/environ can read it back.
#
# systemd parses this file itself: no shell runs, so there is no quoting, no $VAR expansion and no export.

# --- required ---------------------------------------------------------------------------------------------

# The operational JSON-RPC endpoint. Usually a credential in its own right (the API key is in the path or the
# query), which is why this file is 0600 and why every log line replaces an absolute URL with <rpc>.
KEEPER_RPC_URL=<https://your-operational-rpc-endpoint>

# 56 for BSC mainnet. Must equal the manifest's chain id and the id the node reports, or start-up refuses.
KEEPER_CHAIN_ID=<56>

# Lowercase. Selects config/deployments/<KEEPER_CHAIN_ID>/<this address>.json inside the checkout.
KEEPER_DRAW_ADDRESS=<0x0000000000000000000000000000000000000000>

# --- optional ---------------------------------------------------------------------------------------------

# Dead-man's-switch ping, sent after every healthy cycle. Unset means nothing is ever sent.
# The path is a bearer token for most monitors, so treat it as a secret.
#KEEPER_HEARTBEAT_URL=<https://your-monitor.example/ping/00000000-0000-0000-0000-000000000000>

# GET (default) or POST. POST sends a small JSON body {"ok":true,"block":...,"tracked":...}.
#KEEPER_HEARTBEAT_METHOD=GET

# Where alerts are POSTed as JSON ({"text":..., "cause":..., "detail":{...}}, which chat webhooks render).
# Unset means no alert is ever posted. One alert per cause per hour, per process: a cause that keeps
# failing cycles exits the unit, systemd restarts it, and the limiter starts over - expect a page about
# every three minutes for a persistent fault, not one an hour.
#KEEPER_ALERT_WEBHOOK=<https://hooks.example.com/services/000000/000000/000000000000000000000000>

# Cycle period in milliseconds. Default 15000.
#KEEPER_INTERVAL_MS=15000

# Blocks per eth_getLogs page. Default 2000; lower it if the RPC caps ranges more tightly.
#KEEPER_LOG_WINDOW=2000

# 1 simulates every call and sends nothing. Use for a rehearsal, never for a running deployment.
#KEEPER_DRY_RUN=1

# Manifest tree root. Only for a manifest kept outside the checkout; defaults to <checkout>/config/deployments.
#KEEPER_DEPLOYMENTS_DIR=/opt/luckydraw/config/deployments
