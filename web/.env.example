# Which deployment this build is pinned to. The pair selects
# config/deployments/<VITE_LUCKYDRAW_CHAIN_ID>/<VITE_LUCKYDRAW_DRAW_ADDRESS>.json, which must exist at build
# time; the address is always lowercase (SPEC §12). Defaults below are the local anvil mock deployment
# written by contracts/script/DeployLocal.s.sol.
VITE_LUCKYDRAW_CHAIN_ID=31337
VITE_LUCKYDRAW_DRAW_ADDRESS=0x610178da211fef7d417bc0e6fed39f05609ad788

# Public read RPC. config/chains/<chainId>.json names this variable in `rpcEnvVars.public` and deliberately
# carries no URL of its own, so this is required rather than an override. Its origin is what the
# Content-Security-Policy `connect-src` is narrowed to; several whitespace- or comma-separated URLs are
# allowed and every origin is admitted, but only the first is used for reads.
VITE_LUCKYDRAW_RPC_URL=http://127.0.0.1:8545

# Optional. How often the app asks for a new block number, in milliseconds. SPEC §10.1 caps snapshot refresh
# at one per 4 seconds and one idle tab at 30 RPC requests per minute; 3000 is the default for BSC.
# VITE_LUCKYDRAW_BLOCK_POLL_MS=3000

# The operator's jurisdiction sentence (SPEC §14). Plain text, shown on the help and verify pages and next
# to the entry panel; never interpreted as HTML. Empty is fine on a local or testnet build and is the
# default; a chain 56 build refuses to start without it. See web/.env.mainnet.example.
# VITE_LUCKYDRAW_JURISDICTION_NOTICE=
