# BSC testnet build. Copy this file to web/.env (untracked) and fill in the two placeholders before
# building; see docs/runbooks/testnet-launch.md for where the values come from.
#
# Nothing here is a secret and nothing secret may be added: every value in this file is compiled into a
# static bundle that every visitor downloads, and the RPC URL is additionally handed to the wallet by
# `wallet_addEthereumChain` (SPEC §10.4).

# Chain 97 is BSC testnet. config/chains/97.json is its chain record and must exist, which it does.
VITE_LUCKYDRAW_CHAIN_ID=97

# The Draw address from your own deployment manifest, lowercase. With the chain id above it selects
# config/deployments/97/<lowercase draw address>.json, which `Finalize` writes and which must exist at
# build time: `vite build` fails in buildStart when it does not (SPEC §12). There is no default to fall
# back on, so replace the placeholder — the build will not guess an address.
VITE_LUCKYDRAW_DRAW_ADDRESS=<lowercase draw address from your manifest>

# Public read RPC for chain 97. config/chains/97.json names this variable in `rpcEnvVars.public` and
# deliberately carries no URL of its own, so the operator picks a public BSC testnet endpoint and puts its
# origin here; the repository does not choose one for you. Give an origin (and at most a path) only: a
# value carrying credentials or a query string is refused at parse time, because that is where provider API
# keys live and this build is public. Keep any keyed endpoint for the operator's own tooling
# (LUCKYDRAW_OPS_RPC_URL, read by the keeper), never here. Several URLs may be given, whitespace- or
# comma-separated: the first is used for reads and every origin is admitted by the CSP `connect-src`.
VITE_LUCKYDRAW_RPC_URL=<public BSC testnet RPC origin, no key and no query string>

# The path the site is served under, with a leading and a trailing slash. A GitHub Pages project site lives
# at https://<user>.github.io/<repo>/, so both the asset URLs and the router's basename need that prefix.
# Leave it unset, or set it to "/", for a site served from the root of its own domain. The GitHub Actions
# workflow derives this from the repository name instead of reading this file.
VITE_LUCKYDRAW_BASE=/luckydraw/

# Optional. How often the app asks for a new block number, in milliseconds. SPEC §10.1 keeps an idle tab
# under 30 RPC requests a minute; 3000 is the default and is right for BSC.
# VITE_LUCKYDRAW_BLOCK_POLL_MS=3000

# Optional on chain 97, required on chain 56. The operator's jurisdiction sentence (SPEC §14), rendered as
# plain text on the help and verify pages and next to the entry panel. See web/.env.mainnet.example.
# VITE_LUCKYDRAW_JURISDICTION_NOTICE=
