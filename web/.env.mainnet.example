# BSC MAINNET build. Real money. Copy this file to web/.env (untracked) and fill in the three placeholders
# before building; see docs/runbooks/mainnet-launch.md for where each value comes from.
#
# Nothing here is a secret and nothing secret may be added: every value in this file is compiled into a
# static bundle that every visitor downloads, and the RPC URL is additionally handed to the wallet by
# `wallet_addEthereumChain` (SPEC §10.4).
#
# A chain 56 build runs the release gate in web/src/lib/build/releaseGate.ts before it emits a file. It
# refuses, with one reason line and a non-zero exit, unless all of the following hold:
#
#   * config/deployments/56/<draw address>.json exists and its `environment` is "mainnet";
#   * that manifest flags no mock anywhere (`isMock`, `coordinatorIsMock`, `feedIsMock` all false);
#   * its top-level `release.customerLaunch` is exactly true, which the operator sets only after the
#     SPEC §14 private shakedown is played and recorded in `release.shakedown`;
#   * `node scripts/validate_config.ts` passes over the whole `config/` tree;
#   * VITE_LUCKYDRAW_JURISDICTION_NOTICE below is non-empty.
#
# The un-prefixed spellings (LUCKYDRAW_CHAIN_ID, LUCKYDRAW_DRAW_ADDRESS, LUCKYDRAW_RPC_URL,
# LUCKYDRAW_JURISDICTION_NOTICE) are accepted from the environment as well, which is how the GitHub
# repository variables reach the build; setting both spellings to different values is refused.

# Chain 56 is BSC mainnet. config/chains/56.json is its chain record and must exist, which it does.
VITE_LUCKYDRAW_CHAIN_ID=56

# The Draw address from your own deployment manifest, lowercase. With the chain id above it selects
# config/deployments/56/<lowercase draw address>.json, which `Finalize` writes. There is no default and the
# build will not guess an address.
VITE_LUCKYDRAW_DRAW_ADDRESS=<lowercase draw address from your manifest>

# Public read RPC for chain 56. config/chains/56.json names this variable in `rpcEnvVars.public` and
# deliberately carries no URL of its own, so the operator picks a public BSC mainnet endpoint and puts its
# origin here. Give an origin (and at most a path) only: a value carrying credentials or a query string is
# refused at parse time, because that is where provider API keys live and this build is public. Keep any
# keyed endpoint for the operator's own tooling (LUCKYDRAW_OPS_RPC_URL, read by the keeper), never here.
# Several URLs may be given, whitespace- or comma-separated: the first is used for reads and every origin is
# admitted by the CSP `connect-src`.
VITE_LUCKYDRAW_RPC_URL=<public BSC mainnet RPC origin, no key and no query string>

# REQUIRED on chain 56. One or two plain sentences stating the outcome of the operator's own jurisdiction
# advice: who may use this and where it is not offered (SPEC §14, "Qualified advisers must determine
# jurisdiction, licensing, eligible audience"). It is rendered as text on the help page, the verify page and
# next to the entry panel on every round; it is never interpreted as HTML, so markup in it will be shown
# literally rather than rendered. The repository chooses no wording for you and the build fails if it is
# empty. Keep it on one line.
VITE_LUCKYDRAW_JURISDICTION_NOTICE=<the sentence your advisers gave you>

# The path the site is served under, with a leading and a trailing slash. A GitHub Pages project site lives
# at https://<user>.github.io/<repo>/, so both the asset URLs and the router's basename need that prefix.
# Leave it unset, or set it to "/", for a site served from the root of its own domain. The GitHub Actions
# workflow derives this from the repository name instead of reading this file.
VITE_LUCKYDRAW_BASE=/luckydraw/

# Optional. How often the app asks for a new block number, in milliseconds. SPEC §10.1 keeps an idle tab
# under 30 RPC requests a minute; 3000 is the default and is right for BSC.
# VITE_LUCKYDRAW_BLOCK_POLL_MS=3000
