{
  "name": "@luckydraw/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LuckyDraw web app: wallet connection, network guard, app shell, deployment/read context, transaction state machine, string catalog and design tokens (SPEC sections 9.1-9.7, 10.1, 12).",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/pages-postbuild.mjs",
    "pages:postbuild": "node scripts/pages-postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@luckydraw/client": "workspace:*",
    "ethers": "6.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
